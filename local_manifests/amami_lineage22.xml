<?xml version="1.0" encoding="UTF-8"?>
<!-- Manifest LineageOS 22.x (Android 15) untuk Sony Xperia Z1 Compact (amami) -->
<!-- Menggabungkan fondasi 115ek + HAL Display/Media Ultra-Legacy-Hippeastrum (Lineage 22.2) + timekeep rthery -->
<manifest>
  <!-- Device Trees & Common Rhine/MSM8974 -->
  <project name="lin18-microG/android_device_sony_amami" path="device/sony/amami" revision="lineage-18.1" />
  <project name="115ek/android_device_sony_rhine-common" path="device/sony/rhine-common" revision="lineage-19.0-WIP" />
  <project name="115ek/android_device_sony_msm8974-common" path="device/sony/msm8974-common" revision="lineage-19.0-WIP" />
  <project name="AICP/device_sony_common" path="device/sony/common-caf" revision="r11.1-caf" />

  <!-- Kernel Source (MSM8974 Downstream 3.4 Modernized) -->
  <project name="115ek/android_kernel_sony_msm8974" path="kernel/sony/msm8974" revision="lineage-19.0-WIP" />

  <!-- Proprietary Vendor Blobs Sony Rhine / Amami -->
  <project name="lin18-microG/proprietary_vendor_sony_amami" path="vendor/sony" revision="lineage-18.1" />

  <!-- Sony Hardware Daemons & Compatibility -->
  <project name="LineageOS/android_hardware_sony_macaddrsetup" path="hardware/sony/macaddrsetup" revision="lineage-18.1" />
  <project name="LineageOS/android_hardware_sony_thermanager" path="hardware/sony/thermanager" revision="lineage-18.1" />
  <project name="rthery/android_hardware_sony_timekeep" path="hardware/sony/timekeep" revision="lineage-22.2-bullhead" />
  <project name="LineageOS/android_external_sony_boringssl-compat" path="external/sony/boringssl-compat" revision="lineage-18.1" />

  <!-- Qualcomm Legacy HALs (Ultra-Legacy-Hippeastrum for LineageOS 22.2) -->
  <remove-project name="LineageOS/android_hardware_qcom_display" />
  <remove-project name="LineageOS/android_hardware_qcom_media" />
  <project name="Ultra-Legacy-Hippeastrum/android_hardware_qcom_display" path="hardware/qcom/display" revision="lineage-22.2" />
  <project name="Ultra-Legacy-Hippeastrum/android_hardware_qcom_media" path="hardware/qcom/media" revision="lineage-22.2" />
  <project name="LineageOS/android_hardware_qcom_audio" path="hardware/qcom-caf/msm8974/audio" revision="lineage-18.1-caf-msm8974" />

  <!-- Build Tools & Legacy Sepolicy -->
  <project name="LineageOS/android_device_qcom_sepolicy" path="device/qcom/sepolicy-legacy" revision="lineage-18.1-legacy" />
  <project name="LineageOS/android_system_tools_dtbtool" path="system/tools/dtbtool" revision="lineage-18.1" />
  <project name="LineageOS/android_external_connectivity" path="external/connectivity" revision="lineage-18.1" />
</manifest>
