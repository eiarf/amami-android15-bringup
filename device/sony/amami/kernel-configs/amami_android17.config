# Kernel config fragment for Sony Xperia Z1 Compact (amami) - Android 17 + Mainline 6.16
# Applied on top of arch/arm/configs/msm8974_defconfig

# Android IPC & Runtime Requirements
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_PSI=y
CONFIG_MEMFD_CREATE=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# Storage & Filesystems (built-in for early mount)
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_DM_VERITY=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# Graphics (DRM MSM + Adreno 330 built-in so SurfaceFlinger/HWC3 starts cleanly)
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_MDP5=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_28NM_PHY=y
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_DRM_PANEL_SONY_AMAMI_NOVATEK=y

# Wi-Fi & Networking (built-in for Android netd / ConnectivityService / wcn36xx)
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WCN36XX=y
CONFIG_RFKILL=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_FW_LOADER=y

# USB Gadget (ADB / MTP)
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_MTP=y
CONFIG_USB_CONFIGFS_F_PTP=y
CONFIG_USB_CONFIGFS_F_ACC=y

# Security / SELinux
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_AUDIT=y

# Boot & Appended DTB (Required for Sony Rhine bootloader / mainline 6.16)
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAGS=y

# Kernel Compression (Use standard GZIP to avoid host xz BCJ filter limitations)
CONFIG_KERNEL_GZIP=y
# CONFIG_KERNEL_XZ is not set

# Disable module compression (Android hermetic build restricts zstd)
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_MODULE_COMPRESS_ZSTD is not set
CONFIG_MODULE_COMPRESS_NONE=y
