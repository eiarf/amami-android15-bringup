diff --git a/BoardConfig.mk b/BoardConfig.mk
index a1f154d..5651e66 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -25,19 +25,34 @@ TARGET_SPECIFIC_HEADER_PATH += device/sony/amami/include
 
 BOARD_BLUETOOTH_BDROID_BUILDCFG_INCLUDE_DIR := device/sony/amami/bluetooth
 
-# Kernel properties
+# Kernel properties (S1Boot verified: appended DTB + 0x01000000 ramdisk, no earlyprintk/vmalloc=300M)
 TARGET_KERNEL_CONFIG := lineageos_rhine_amami_row_defconfig
+BOARD_KERNEL_IMAGE_NAME := zImage-dtb
+BOARD_KERNEL_SEPARATED_DT := false
+BOARD_MKBOOTIMG_ARGS := --ramdisk_offset 0x01000000 --tags_offset 0x01E00000
+BOARD_KERNEL_CMDLINE := androidboot.hardware=qcom user_debug=31 msm_rtb.filter=0x37 ehci-hcd.park=3 androidboot.bootdevice=msm_sdcc.1 dwc3.maximum_speed=high dwc3_msm.prop_chg_detect=Y androidboot.selinux=permissive
 
-# Partition information
+# Partition information (Verified physical mmcblk0 limits)
 BOARD_VOLD_MAX_PARTITIONS := 26
 
-BOARD_BOOTIMAGE_PARTITION_SIZE := 0x01400000
-BOARD_RECOVERYIMAGE_PARTITION_SIZE := 0x01400000
+BOARD_BOOTIMAGE_PARTITION_SIZE := 20971520
+BOARD_RECOVERYIMAGE_PARTITION_SIZE := 20971520
 BOARD_SYSTEMIMAGE_PARTITION_SIZE := 2436890624
 BOARD_USERDATAIMAGE_PARTITION_SIZE := 12891175936
 BOARD_CACHEIMAGE_PARTITION_SIZE := 209715200
 
-#Recovery
+BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := ext4
+BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := f2fs
+BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4
+
+# Non-A/B & Verified Boot disabled for legacy S1Boot
+AB_OTA_UPDATER := false
+BOARD_AVB_ENABLE := false
+
+# Low-RAM / Legacy 32-bit partition budget
+MALLOC_SVELTE := true
+
+# Recovery
 BOARD_USE_CUSTOM_RECOVERY_FONT := \"roboto_15x24.h\"
 
 # Security patch level
