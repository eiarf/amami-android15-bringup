+# Android 13 cgroups (from MakeDecisionWorth lineage-20.0 aa10daf4)
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CPUSETS=y
+CONFIG_PROC_PID_CPUSET=y
+CONFIG_CGROUP_MEM_RES_CTLR_KMEM=y
+CONFIG_CGROUP_PERF=y
+CONFIG_BLK_CGROUP=y
+
+# Debugging & /proc/config.gz (guideline.md Phase 1 + android_os_Debug_isVmapStack)
