+CONFIG_ARM_ATAG_DTB_COMPAT=y
+CONFIG_BUILD_ARM_APPENDED_DTB_IMAGE_NAMES="msm8974-v2.0-1-rhine_amami_row msm8974-v2.2-rhine_amami_row"
+
+# Ramdisk XZ option (in case recovery ramdisk grows near 20 MiB)
+CONFIG_RD_XZ=y
