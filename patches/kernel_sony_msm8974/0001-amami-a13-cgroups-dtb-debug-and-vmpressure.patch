diff --git a/scripts/xz_wrap.sh b/scripts/xz_wrap.sh
index 7a2d372f..4fff055a 100755
--- a/scripts/xz_wrap.sh
+++ b/scripts/xz_wrap.sh
@@ -15,9 +15,14 @@ LZMA2OPTS=
 case $SRCARCH in
 	x86)            BCJ=--x86 ;;
 	powerpc)        BCJ=--powerpc ;;
-	ia64)           BCJ=--ia64; LZMA2OPTS=pb=4 ;;
+	ia64)           BCJ=--ia64; LZMA2OPTS=pb=4, ;;
 	arm)            BCJ=--arm ;;
 	sparc)          BCJ=--sparc ;;
 esac
 
-exec xz --check=crc32 $BCJ --lzma2=$LZMA2OPTS,dict=32MiB
+XZ_BIN=xz
+if [ -x /usr/bin/xz ]; then
+	XZ_BIN=/usr/bin/xz
+fi
+
+exec "$XZ_BIN" --check=crc32 $BCJ --lzma2=${LZMA2OPTS}dict=32MiB
