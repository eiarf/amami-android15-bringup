+struct amami_novatek {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	int (*init_seq)(struct mipi_dsi_device *dsi);
+};
+
+static inline struct amami_novatek *to_amami_novatek(struct drm_panel *panel)
+{
+	return container_of(panel, struct amami_novatek, panel);
+}
+
+static void amami_novatek_reset(struct amami_novatek *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(20000, 21000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(200, 1000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(20000, 21000);
+}
